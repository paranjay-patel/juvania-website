---
interface Props {
	class?: string;
	showText?: boolean;
}

const { class: className = "w-8 h-8", showText = true } = Astro.props;
---
<div class="flex items-center gap-2.5">
	<!-- Juvania Graphic Mark ('J' + Steam Iron / Freshness Sparkle Motif) -->
	<svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
		<defs>
			<linearGradient id="juvania-grad" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
				<stop offset="0%" stop-color="#0284C7" />
				<stop offset="100%" stop-color="#6366F1" />
			</linearGradient>
			<linearGradient id="juvania-accent" x1="0" y1="0" x2="32" y2="0" gradientUnits="userSpaceOnUse">
				<stop offset="0%" stop-color="#38BDF8" />
				<stop offset="100%" stop-color="#818CF8" />
			</linearGradient>
		</defs>
		
		<!-- Soft subtle background fill -->
		<path 
			d="M20 4H10C7.79086 4 6 5.79086 6 8V18C6 22.4183 9.58172 26 14 26C18.4183 26 22 22.4183 22 18V8C22 5.79086 20.2091 4 18 4Z" 
			fill="url(#juvania-grad)" 
			class="opacity-[0.08]"
		/>
		
		<!-- Main Letter 'J' & Steam Iron Curve -->
		<path 
			d="M20 4H12C9.79086 4 8 5.79086 8 8V17C8 20.866 11.134 24 15 24C18.866 24 22 20.866 22 17V6" 
			stroke="url(#juvania-grad)" 
			stroke-width="3" 
			stroke-linecap="round" 
			stroke-linejoin="round"
		/>
		
		<!-- Inner Iron Handle / Press Detail -->
		<path 
			d="M13 10H17C18.1046 10 19 10.8954 19 12C19 13.1046 18.1046 14 17 14H14" 
			stroke="url(#juvania-grad)" 
			stroke-width="2.5" 
			stroke-linecap="round" 
			stroke-linejoin="round"
		/>
		
		<!-- Sparkles/Steam particles for freshness -->
		<path d="M26 4L27.5 5.5M27.5 4L26 5.5" stroke="#818CF8" stroke-width="1.5" stroke-linecap="round" />
		<circle cx="28" cy="9" r="1.25" fill="#0284C7" />
	</svg>
	
	{showText && (
		<span class="font-display text-2xl font-black tracking-tight text-slate-900">
			Juv<span class="text-primary">ania</span>
		</span>
	)}
</div>
